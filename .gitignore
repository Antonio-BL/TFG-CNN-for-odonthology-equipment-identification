# Python bytecode
__pycache__/
*.py[cod]

# Virtual environment (large — never commit)
venv_TFG/

# Training outputs / model cache
# cnn_results/ IS tracked on purpose: metrics, confusion matrices and the small
# joblib classifier are kept so different training runs (incl. smaller datasets)
# can be compared and documented in the thesis.
# Only bulky deep-net checkpoints from the fine-tuning path are ignored;
# force-add one (git add -f) if you ever need to preserve specific weights.
cnn_results/**/*.pt
cnn_results/**/*.pth
cnn_results/**/*.ckpt
